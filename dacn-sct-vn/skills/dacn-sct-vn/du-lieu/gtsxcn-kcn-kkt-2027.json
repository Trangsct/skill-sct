{
 "_nguon": {
  "van_ban": "Kế hoạch số 72/KH-BQL ngày 08/7/2026 của Ban Quản lý Khu kinh tế tỉnh Lào Cai về Phát triển kinh tế - xã hội năm 2027",
  "phu_luc": "Biểu DỰ TÍNH GIÁ TRỊ SXCN NĂM 2027 kèm theo Kế hoạch 72/KH-BQL",
  "nguoi_ky": "Trưởng ban Vương Trinh Quốc",
  "thoi_gian_ky_so": "08/7/2026 14:01:38 +07:00",
  "noi_nhan": [
